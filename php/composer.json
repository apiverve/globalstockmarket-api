        "globalstockmarket",
        "global stock market",
        "world stock market",
        "country stock market",
        "share price index",
        "international stock market"
    ],
    "homepage": "https://apiverve.com/marketplace/globalstockmarket?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
